# Supabase Supavisor session-mode URL (port 5432) for the application runtime.
DATABASE_URL="postgresql://prisma.PROJECT_REF:PRISMA_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct URL, or Supavisor session-mode URL, used only by Prisma CLI migrations.
DIRECT_URL="postgresql://prisma.PROJECT_REF:PRISMA_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-characters"
SEED_EMPLOYEE_PASSWORD="change-this-employee-password"
SEED_MANAGER_PASSWORD="change-this-manager-password"
